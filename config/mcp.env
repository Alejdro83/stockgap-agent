# StockGap MCP + pay-per-call — todo se lee aqui o del entorno (STOCKGAP_MCP_CONFIG para otro archivo).
# Prioridad: variables de entorno reales > este archivo > defaults del codigo.

# --- modo de cobro: free (demo/jueces, por defecto) | b402 (pago por llamada) ---
MCP_PAY_MODE=free
# local_receipt = el comprador paga on-chain y envia el tx hash (X-Payment: 0x...)
# binance       = adaptador nativo /build/api/v2/b402/{supported,verify,settle}
B402_PROVIDER=local_receipt

# --- precio y destino ---
MCP_MERCHANT=0x069Ac6d8cf3553416fE5a4f0410ebEb758A8F819
# 0.0001 BNB en wei (activo nativo). Para un token ERC-20 pon MCP_ASSET=<direccion> y el precio en unidades minimas.
MCP_PRICE_WEI=100000000000000
MCP_ASSET=native
MCP_CHAIN_ID=56
MCP_NETWORK=eip155:56

# --- verificacion del recibo (RPC publico, solo lectura) ---
MCP_RPC_URL=https://bsc-dataseed.binance.org
MCP_MAX_BLOCK_AGE_S=3600

# --- identidad ERC-8004 (stub; sin llamadas on-chain) ---
MCP_ERC8004_ID=erc8004:bsc-testnet:REGISTRY_PLACEHOLDER#0
