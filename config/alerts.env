# StockGap alertes — tous les seuils/basculs sont lus ici ou depuis l'env.
# Priorite: variables d'environnement reelles > ce fichier > defauts du code.
# Ce fichier est charge automatiquement (STOCKGAP_ALERTS_CONFIG pour un autre chemin).

# --- seuils ---
SPREAD_THRESHOLD_BPS=150
CROSS_ISSUER_THRESHOLD_BPS=100

# --- cadence ---
ALERT_RATE_LIMIT_MIN=30
ALERT_SCAN_INTERVAL=30

# --- mode digest (1 = agrupa alertas y envia 1 mensaje cada ALERT_DIGEST_INTERVAL_MIN) ---
ALERT_DIGEST_MODE=0
ALERT_DIGEST_INTERVAL_MIN=30
ALERT_DIGEST_MAX=20

# --- toggles ---
ALERTS_ENABLED=1
ALERT_SPREAD_ENABLED=1
ALERT_CROSS_ENABLED=1
TELEGRAM_ALERTS=1
ALERT_FILE_LOG=1

# --- métrica de spread para los umbrales ---
# real    = spread_bps_real vs el cierre INDEPENDIENTE del subyacente (por defecto)
# derived = spread_bps vs referencePrice derivada de rwa/price (estructuralmente ~0)
ALERT_METRIC=real

# --- entrega ---
# TELEGRAM_BOT_TOKEN lo inyecta data/alerts.env (nunca se commitea ni se loguea).
TELEGRAM_CHAT_ID=6438086899
ALERT_LOG=data/alerts.jsonl
