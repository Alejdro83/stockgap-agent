# StockGap weekend oracle — todos los parametros se leen aqui o del entorno.
# Prioridad: variables de entorno reales > este archivo > defaults del codigo.
# (STOCKGAP_ORACLE_CONFIG para usar otro archivo)

# --- toggle ---
ORACLE_ENABLED=1

# --- cadencia ---
# Cron ejecuta `oracle.py --once` cada 5 min; en modo bucle este es el intervalo.
ORACLE_INTERVAL_MIN=5

# --- cutoff de puntuacion (UTC): ultimo snapshot antes de pre-market del lunes ---
ORACLE_CUTOFF_WEEKDAY=sunday
ORACLE_CUTOFF_HOUR=23
ORACLE_CUTOFF_MINUTE=59

# --- umbrales / red ---
ORACLE_DEVIATION_FLAG_BPS=100
ORACLE_UNIVERSE_TTL_S=600
ORACLE_BATCH_SIZE=50
ORACLE_STAGGER_S=0.25
