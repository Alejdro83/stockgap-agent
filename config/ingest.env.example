# StockGap hybrid sync — local -> Northflank ingest (hybrid plan v3/v4, Task 3).
#
# Setup:
#   cp config/ingest.env.example config/ingest.env
#   chmod 600 config/ingest.env
# config/ingest.env is GITIGNORED — never commit real values. Real environment
# variables override these values. The token is NEVER accepted via argv (it
# would be visible in `ps` and `crontab -l`) and never logged.

# Northflank base URL of the dashboard service (trailing slash optional).
STOCKGAP_INGEST_URL=https://your-service.northflank.com

# Bearer token — MUST equal the STOCKGAP_INGEST_TOKEN secret linked on NF
# (>= 32 chars; the endpoint answers 503 "ingest disabled" below that).
STOCKGAP_INGEST_TOKEN=change-me-32-chars-minimum-aaaaaaaaaaaa

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown; safe to leave commented out)

# Rows per POST (1..1000). If NF answers 413, halve SHIP_BATCH.
#SHIP_BATCH=500

# Fresh-start / --reset backfill window in hours (clamped to the 2-6h band),
# applied per table's ts column (ts_utc for spread_ticks/cross_issuer_ticks,
# snapshot_ts for oracle_predictions). NEVER id 0 by default.
#SHIP_BACKFILL_HOURS=4

# Explicit backfill start instead of the hours window: ship ids >= N.
#SHIP_BACKFILL_FROM_ID=

# Preflight override: 1 = ship into a non-empty NF DB anyway (dangerous —
# old-collector rows cannot be distinguished; see the cutover runbook).
#SHIP_FORCE=0

# 1 = shadow run: log what would ship, make NO network calls, write no
# watermark.
#SHIP_DRY_RUN=0

# Per-pass wall-clock budget for the drain loop (seconds) so cron passes end
# before the next tick.
#SHIP_BUDGET_S=50

# Local collector DB (default: <repo>/data/spread_ticks.db).
#STOCKGAP_DB=
